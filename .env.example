# Copy to .env and fill in. Only the control plane reads these.

# LLM provider: bedrock | anthropic
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-opus-5

# --- AWS Bedrock (the chosen path) --------------------------------------
# Standard AWS credential chain, SigV4. Session token is optional and only
# needed for temporary STS/SSO credentials -- note those EXPIRE in 1-12h, so
# re-export before a demo or use a long-lived IAM key scoped to
# bedrock:InvokeModel + bedrock:InvokeModelWithResponseStream.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Direct Anthropic API (fallback) ------------------------------------
# Only used when LLM_PROVIDER=anthropic. Model id drops the anthropic. prefix.
ANTHROPIC_API_KEY=

# Confidence floors (optional). Unset -> platform/policy/policy.yaml decides.
# services.yaml `confidence_floors:` on a service overrides both, per service.
#ASHS_AUTONOMOUS_FLOOR=0.85
#ASHS_REVIEW_FLOOR=0.60
